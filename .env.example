# Optional live smoke checks. Copy to ignored .env and set values locally.
# Choose text-chat models that support max_tokens and this gateway's subset.
# OpenAI-only: --provider openai requires only these two values.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional; needed only for --provider anthropic or --provider both.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
