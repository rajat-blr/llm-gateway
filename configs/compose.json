{
  "listen": ":8080",
  "key_env": "GATEWAY_API_KEY",
  "request_timeout": "30s",
  "idle_timeout": "5s",
  "write_timeout": "5s",
  "shutdown_timeout": "10s",
  "max_body_bytes": 1048576,
  "max_output_bytes": 8388608,
  "max_event_bytes": 65536,
  "max_concurrent": 64,
  "max_streams": 32,
  "providers": {
    "mock-openai": {
      "kind": "openai",
      "base_url": "http://mock:9090/v1",
      "key_env": "MOCK_API_KEY"
    },
    "mock-anthropic": {
      "kind": "anthropic",
      "base_url": "http://mock:9090/v1",
      "key_env": "MOCK_API_KEY"
    }
  },
  "routes": {
    "default-chat": {
      "provider": "mock-openai",
      "model": "mock-text",
      "max_output_tokens": 1024
    },
    "anthropic-chat": {
      "provider": "mock-anthropic",
      "model": "mock-text",
      "max_output_tokens": 1024
    }
  }
}
