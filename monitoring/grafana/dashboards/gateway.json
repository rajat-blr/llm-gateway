      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llmgw_active_work_slots",
          "legendFormat": "work slots"
        },
        {
          "refId": "B",
          "expr": "llmgw_active_streams",
          "legendFormat": "streams"
        },
        {
          "refId": "C",
          "expr": "llmgw_active_attempts",
          "legendFormat": "upstream attempts"
        },
        {
          "refId": "D",
          "expr": "llmgw_shared_executions",
          "legendFormat": "shared executions"
        },
        {
          "refId": "E",
          "expr": "llmgw_shared_waiters",
          "legendFormat": "shared waiters"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
