          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, outcome) (rate(llmgw_attempts_total[1m]))",
          "legendFormat": "{{provider}} {{outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(llmgw_fallbacks_total[1m]))",
          "legendFormat": "fallback"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
